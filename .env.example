# Copy this file to .env and fill in your settings

# ── LLM Backend ──────────────────────────────────────────────────────────────
# Option A: Use Claude Code CLI (must be installed: https://claude.ai/code)
# If set to true, ANTHROPIC_API_KEY is not needed.
CLAUDE_CODE=true

# Option B: Use Anthropic API directly
# Only used when CLAUDE_CODE=false.
# IMPORTANT: if you use CLAUDE_CODE=true, leave this blank or remove it entirely.
# Leaving a placeholder value here (sk-ant-...) will cause "invalid API key" errors
# because the claude CLI subprocess will try to use it instead of your login session.
ANTHROPIC_API_KEY=
