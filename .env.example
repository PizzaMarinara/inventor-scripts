# Copy this file to .env and fill in your settings

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Supported providers: anthropic, claude_code, openrouter, openai, groq, together, ollama, custom
LLM_PROVIDER=anthropic

# ── API Key ────────────────────────────────────────────────────────────────────
# Required for all providers except claude_code (uses your Claude CLI login session)
LLM_API_KEY=

# ── Model Override (optional) ──────────────────────────────────────────────────
# Leave blank to use the provider's default model
LLM_MODEL=

# ── Custom Base URL ────────────────────────────────────────────────────────────
# Only needed when LLM_PROVIDER=custom
LLM_BASE_URL=

# ── Max Tokens ─────────────────────────────────────────────────────────────────
# Maximum tokens for LLM responses. Increase for complex tool-heavy conversations.
MAX_TOKENS=4096
